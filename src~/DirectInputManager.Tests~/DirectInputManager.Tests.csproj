<Project Sdk="Microsoft.NET.Sdk">

  <!-- Linux/Windows runnable tests for the managed layer. Compiles the real
       Runtime/DirectInputManager.cs exactly as the Explorer does (linked file,
       no Unity defines) so struct layouts and pure logic are tested against
       the shipped source, not a copy. No native DLL is loaded. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA2101;CS0105;IDE0079</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Runtime\DirectInputManager.cs" Link="DirectInputManager.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
